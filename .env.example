# Copia este archivo a .env y rellena los valores (ver SETUP.md)

# Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6
MAX_TOKENS=8192

# Servidor
PORT=3000
BRAND_NAME=Florhuila
# Clave para que tu equipo entre al chat (déjala vacía para no pedir clave)
ACCESS_PASSWORD=

# Google OAuth (obtenido con authorize.js, ver SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Carpeta de Drive destino de las parrillas
DRIVE_FOLDER_ID=1SkdHBXYceseHniqW7gL91t_1ye5Vaxu2

# ID del deck de Google Slides que sirve de template (ficha con placeholders {{...}})
PARRILLA_TEMPLATE_ID=
